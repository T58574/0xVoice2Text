# --- SECRETS, API KEYS & TOKENS (STRICTLY PRIVATE) ---
.env
.env.*
*.env
*.pem
*.key
*.token
*.credentials
credentials.json
client_secret*.json
api_keys.*

# --- VIRTUAL ENVIRONMENTS ---
venv/
.venv/
env/
ENV/
virtualenv/
lib/
lib64/
share/
include/

# --- PYTHON RUNTIME & BYTECODE ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
build/
dist/
out/
*.manifest
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- IDE & OS SYSTEM FILES ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

